# Roll No: evernorth-aai-1164386
# Copy to .env (never commit/submit .env). With no model configured, inboxHero runs its
# deterministic offline analyst, so every manifest command still works.

# --- Model: any OpenAI-compatible chat-completions endpoint. Key is read from <MODEL_PROVIDER>_API_KEY.
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-key-here
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Local model while building (no rate limits):
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.1:8b

# Gemini alternative:
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_NAME=gemini-2.5-flash

# No model at all (offline analyst):
# MODEL_PROVIDER=offline

MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT=120
MODEL_MAX_TOKENS=2048

# --- Rate limits: seconds between calls, retries on HTTP 429, messages per triage call
LLM_MIN_INTERVAL=4
LLM_MAX_RETRIES=4
TRIAGE_BATCH_SIZE=8

# --- Mailbox owner
OWNER_EMAIL=sam@paperjet.io
OWNER_NAME=Sam
